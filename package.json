{
  "name": "beds-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite apps/web/labs/espaco-library --config apps/web/labs/espaco-library/vite.config.ts",
    "build": "npm run build --workspace beds",
    "typecheck": "npm run typecheck --workspace beds && tsc -p apps/web/labs/espaco-library/tsconfig.json",
    "check": "npm run check --workspace beds",
    "check:docs": "npm run check:docs --workspace beds",
    "check:consumer": "node scripts/check-example-consumers.mjs",
    "test": "npm run test:guards --workspace beds && node --test packages/beds/scripts/quality-routing.test.mjs",
    "test:browser": "playwright test --config apps/web/labs/espaco-library/playwright.config.ts",
    "check:artifact": "npm run check:artifact --workspace beds",
    "verify": "npm run build && npm run typecheck && npm run check && npm run check:docs && npm run check:consumer && npm test && npm run check:artifact"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}

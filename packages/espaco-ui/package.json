{
  "name": "@espaco/ui",
  "version": "0.1.7-rc.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/meunomeebero/beds.git",
    "directory": "packages/espaco-ui"
  },
  "description": "A constrained personal SaaS interface library. Measured geometry, two themes, one brand color.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "fonts",
    "scripts",
    "docs",
    "evidence",
    "examples",
    "AGENTS.md",
    "README.md",
    "tsconfig.build.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": "./dist/tokens.js",
    "./reset.css": "./dist/reset.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": ">=5.9 <7"
  },
  "dependencies": {
    "lucide-react": "^1.24.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "check": "node scripts/check-library.mjs --tokens src/tokens.css",
    "check:consumer": "node scripts/check-consumer.mjs",
    "test:guards": "node --test scripts/contracts.test.mjs scripts/visual-audit.test.mjs scripts/package-artifact.test.mjs scripts/build-artifact.test.mjs scripts/docs.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:visual-baseline": "node scripts/check-visual-baseline.mjs",
    "check:artifact": "node scripts/check-package-artifact.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}

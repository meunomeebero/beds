{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@espaco/ui": [
        "../../../../packages/espaco-ui/src/index.ts"
      ]
    }
  },
  "include": [
    "*.tsx",
    "*.ts",
    "../../../../packages/espaco-ui/src/**/*"
  ]
}

